// Kitty：最大化并启用模糊
window-rule {
    match app-id="^kitty$"
    draw-border-with-background false
    open-maximized true

    background-effect {
        blur true
        xray false
    }
}

// 工具窗口：浮动并聚焦
window-rule {
    match app-id="^niri-keybindings$"
    match app-id="^niri-script-launcher$"
    match app-id="^niri-wallpaper$"
    match app-id="^niri-clipboard$"
    match app-id="^niri-power$"
    open-floating true
    open-focused true
    default-column-width {}
    draw-border-with-background false
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}
