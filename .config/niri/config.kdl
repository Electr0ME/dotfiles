// 输入设备
input {
    keyboard {
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }
}

include "outputs.kdl"

// 布局与窗口外观
layout {
    gaps 12
    background-color "#1e1e2e"
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#cba6f7"
        inactive-color "#45475a"
    }

    border {
        off
        width 4
        active-color "#cba6f7"
        inactive-color "#45475a"
        urgent-color "#9b0000"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#11111b88"
    }
}

// 启动 Waybar、mako、壁纸、剪贴板等会话组件
spawn-sh-at-startup "sh ~/.config/niri/session-start.sh"

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

environment {
    QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"
    // 原生 GTK Wayland 应用使用输入法协议
    GTK_IM_MODULE null
    GTK_THEME "catppuccin-mocha-mauve-standard+default"
}

// 使用 script/keybindings.py 替代内置快捷键提示
hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

include "window-rules.kdl"
include "binds.kdl"
