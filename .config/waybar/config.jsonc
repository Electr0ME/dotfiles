{
  "layer": "top",
  "position": "top",
  "height": 28,
  "margin-top": 0,
  "margin-bottom": 0,
  "fixed-center": true,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 4,
  "modules-left": ["niri/workspaces"],
  "modules-center": ["niri/window"],
  "modules-right": ["tray","cpu", "memory", "network", "wireplumber", "custom/notification", "clock"],
  "custom/launcher": {
    "format": "󰣇",
    "tooltip-format": "应用启动器 · Super+D",
    "on-click": "fuzzel"
  },
  "niri/workspaces": {
    "format": "{index}",
    "all-outputs": false
  },
  "niri/window": {
    "format": "{title}",
    "max-length": 35,
    "separate-outputs": true
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%Y-%m-%d  %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 3,
    "tooltip": true
  },
  "memory": {
    "format": " {percentage}%",
    "interval": 5,
    "tooltip-format": "内存：{used:0.1f} / {total:0.1f} GiB"
  },
  "network": {
    "format-ethernet": "󰈀 {ifname}",
    "format-wifi": " {essid}",
    "format-disconnected": "󰖪 离线",
    "tooltip-format": "{ifname} · {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "on-click": "env XDG_CURRENT_DESKTOP=GNOME gnome-control-center network",
    "interval": 5
  },
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 静音",
    "format-icons": ["", "", ""],
    "scroll-step": 2,
    "max-volume": 100,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰂛",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
    "restart-interval": 3
  },
  "custom/lock": {
    "format": "",
    "tooltip-format": "锁屏 · Super+Alt+L",
    "on-click": "swaylock"
  }
}
