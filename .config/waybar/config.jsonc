{
  "layer": "top",
  "position": "top",
  "height": 28,
  "margin-top": 0,
  "margin-bottom": 0,
  "fixed-center": true,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 4,

  "modules-left": ["niri/workspaces","niri/window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/cpu", "memory", "network", "wireplumber", "custom/notification","tray"],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip-format": "应用启动器 · Super+D",
    "on-click": "fuzzel"
  },
  "niri/workspaces": {
    "format": "{index}",
    "all-outputs": false
  },
  "niri/window": {
    "format": "{title}",
    "max-length": 35,
    "separate-outputs": true
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%Y-%m-%d  %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "custom/cpu": {
    "exec": "sh -c 'exec ~/.config/waybar/scripts/cpu.sh'",
    "interval": 2,
    "return-type": "json",
    "format": " {text}",
    "tooltip": true
  },
  "memory": {
    "format": " {percentage}%",
    "interval": 5,
    "tooltip-format": "内存：{used:0.1f} / {total:0.1f} GiB"
  },
  "network": {
    "format-ethernet": "󰈀 ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "format-wifi": " ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "format-disconnected": "󰖪 离线",
    "tooltip-format": "{ifname} · {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "on-click": "nm-connection-editor",
    "interval": 1
  },
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 静音",
    "format-icons": ["", "", ""],
    "scroll-step": 2,
    "max-volume": 100,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/notification": {
    "tooltip": true,
    "format": "{text}",
    "return-type": "json",
    "exec": "sh -c 'exec ~/.config/waybar/scripts/notification.sh'",
    "interval": 2,
    "on-click": "makoctl mode -t do-not-disturb"
  },
  "custom/lock": {
    "format": "",
    "tooltip-format": "锁屏 · Super+Alt+L",
    "on-click": "swaylock"
  }
}
