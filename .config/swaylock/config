# Catppuccin Mocha / Mauve — wallpaper is supplied by niri/lock.sh.
color=1e1e2e
scaling=fill
font=JetBrainsMono Nerd Font
font-size=20

# Keep a simple ring visible in the center even before typing.
indicator-idle-visible
indicator-radius=80
indicator-thickness=5

# Dark translucent interior over the wallpaper.
inside-color=1e1e2ecc
inside-clear-color=1e1e2ecc
inside-ver-color=1e1e2ecc
inside-wrong-color=1e1e2ecc
inside-caps-lock-color=1e1e2ecc

ring-color=cba6f7
ring-clear-color=f9e2af
ring-ver-color=89b4fa
ring-wrong-color=f38ba8
ring-caps-lock-color=f9e2af
key-hl-color=a6e3a1
bs-hl-color=f38ba8
caps-lock-key-hl-color=f9e2af
caps-lock-bs-hl-color=f38ba8

separator-color=00000000
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
line-caps-lock-color=00000000

text-color=cdd6f4
text-clear-color=f9e2af
text-ver-color=89b4fa
text-wrong-color=f38ba8
text-caps-lock-color=f9e2af
layout-bg-color=1e1e2ecc
layout-border-color=00000000
layout-text-color=cdd6f4

indicator-caps-lock
show-failed-attempts
ignore-empty-password
