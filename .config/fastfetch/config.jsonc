{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": "none",
  "display": {
    "separator": " " // :
  },
"modules": [
{
  "type": "custom",
  "format": "\u001b[90m─────────────────────────────────────────────────────────────"
},
{
  "type": "os",
  "key": "OS      ",
  "keycolor": "red"
},
{
  "type": "kernel",
  "key": "Kernal  ",
  "keycolor": "red"
},
{
  "type": "packages",
  "key": "Packages",
  "keycolor": "yellow"
},
{
  "type": "uptime",
  "key": "Uptime  ",
  "keycolor": "yellow"
},
{
  "type": "terminal",
  "key": "Terminal",
  "keycolor": "yellow"
},
"break",
{
  "type": "cpu",
  "key": "CPU     ",
  "keycolor": "blue",
  "format": "{name}"
},
{
  "type": "gpu",
  "key": "GPU     ",
  "keycolor": "magenta",
  "format": "{vendor} {name}"
},
{
  "type": "memory",
  "key": "RAM     ",
  "keycolor": "blue"
},
{
  "type": "disk",
  "key": "SSD     ",
  "keycolor": "red"
},
{
  "type": "custom",
  "format": "\u001b[90m─────────────────────────────────────────────────────────────"
},
]
}
